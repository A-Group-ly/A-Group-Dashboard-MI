# =============================================================================
# A-Group Subscription Dashboard — environment template
# Copy to `.env.local` for local development. NEVER commit real values.
# Everything below is a PLACEHOLDER. Production secrets live in the platform
# (Cloudflare `wrangler secret put` / dashboard, GitHub Actions secrets).
#
#   [NOW]    read by the current code
#   [NEXT]   needed as soon as Clerk authentication is added
#   [LATER]  needs a public URL / deployed app
#   [DEPLOY] used by the deploy tooling or CI only, never by application code
# =============================================================================

# --- Database: Neon PostgreSQL ------------------------------------------------
# [NOW] Pooled connection (host contains "-pooler"). Used by the app at runtime.
#       Local Postgres works too, e.g. postgresql://postgres:PASSWORD@localhost:5432/agroup
DATABASE_URL="postgresql://USER:PASSWORD@ep-REPLACE-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# [NEXT] Direct (NOT pooled) connection. Used only by the Prisma CLI (migrate, db push, seed).
#        Requires `directUrl = env("DATABASE_URL_UNPOOLED")` in prisma/schema.prisma (not added yet).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-REPLACE.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Application ---------------------------------------------------------------
# NODE_ENV is set by Next.js / the platform. Do not define it here or in secrets.

# [NEXT] Public base URL of this deployment (absolute links, auth redirects).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [PLANNED, not read yet] Explicit demo-data switch so the UI can label illustrative data.
NEXT_PUBLIC_DEMO_DATA="true"

# [PLANNED, not read yet] Seeding is refused when NODE_ENV=production unless this is "true".
ALLOW_PRODUCTION_SEED="false"

# --- Clerk authentication ---------------------------------------------------------
# [NEXT] From the Clerk dashboard → API keys (use the *development* instance locally).
#        NEXT_PUBLIC_* values are inlined at BUILD time, so CI builds need them too.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"

# [NEXT] Auth routes. Public sign-up should be disabled in Clerk (invitation-only).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Where users land after signing in / up (verify exact names against the installed @clerk/nextjs version).
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# [LATER] Clerk webhook signing secret (whsec_…). Only exists after you register the
#         webhook endpoint https://<your-domain>/api/webhooks/clerk in Clerk, which
#         needs a publicly reachable URL (deployed Worker or a tunnel).
CLERK_WEBHOOK_SIGNING_SECRET="whsec_REPLACE_ME"

# --- Cloudflare (deployment) ---------------------------------------------------------
# [DEPLOY] Only for CI deploys / non-interactive wrangler. Locally, `wrangler login` is enough.
#          Store these as GitHub Actions secrets, not in files.
# CLOUDFLARE_API_TOKEN="REPLACE_ME"
# CLOUDFLARE_ACCOUNT_ID="REPLACE_ME"
#
# Runtime secrets are set on the Worker, not in this file:
#   wrangler secret put DATABASE_URL
#   wrangler secret put CLERK_SECRET_KEY
#   wrangler secret put CLERK_WEBHOOK_SIGNING_SECRET
# `wrangler dev` / local Workers preview reads a git-ignored `.dev.vars` file instead.
